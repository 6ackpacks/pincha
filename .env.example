# Pincha environment example.
#
# Copy this file to .env before running Docker Compose:
#   cp .env.example .env
#
# Do not commit .env to Git.
# Production deployments must use independent secrets and must not reuse example values.
# JWT_SECRET_KEY, database passwords, and object storage passwords must be replaced.

# Application
APP_ENV=development
FRONTEND_URL=http://localhost:3000
BACKEND_URL=http://localhost:8000

# Database and cache
DATABASE_URL=postgresql+asyncpg://pincha:change_me@postgres:5432/pincha
POSTGRES_DB=pincha
POSTGRES_USER=pincha
POSTGRES_PASSWORD=change_me
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1

# Authentication
# Generate a long random value, for example:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET_KEY=replace_with_a_long_random_secret_at_least_32_chars

# Typeless speech-to-text
# Recommended for local deployments that need audio transcription.
# 1. Create a Typeless API key.
# 2. Paste it below.
# 3. Start the backend and submit a video/audio URL.
TYPELESS_API_KEY=replace_with_your_typeless_api_key
TYPELESS_API_BASE=https://api.typeless.com/v1
TYPELESS_MODEL=whisper-1

# Optional OpenAI-compatible speech-to-text fallback.
WHISPER_API_BASE=
WHISPER_API_KEY=
WHISPER_MODEL=whisper-1

# OpenAI-compatible LLM API
# Use any OpenAI-compatible provider for summaries, embeddings, and chat.
OPENAI_API_KEY=replace_with_your_llm_api_key
SUMMARY_API_BASE=https://api.openai.com/v1
SUMMARY_MODEL=gpt-4o-mini
FAST_SUMMARY_MODEL=gpt-4o-mini
DEEP_SUMMARY_MODEL=gpt-4o-mini
WIKI_COMPILER_MODEL=gpt-4o-mini

# Optional embedding API
# Leave empty to reuse SUMMARY_API_BASE and OPENAI_API_KEY.
EMBEDDING_API_BASE=
EMBEDDING_API_KEY=
EMBEDDING_MODEL=text-embedding-3-small

# Optional object storage
MINIO_ENDPOINT=minio:9000
MINIO_ACCESS_KEY=pincha_local
MINIO_SECRET_KEY=change_me

# Optional transcript providers
# These are fallbacks for platforms where native captions are unavailable.
TIKHUB_API_KEY=
SUPADATA_API_KEY=
TRANSCRIPTAPI_API_KEY=
TRANSCRIPTHQ_API_KEY=

# Optional curated content source.
CURATE_SOURCE_API_BASE=https://example.com/api/v2
CURATE_SOURCE_PUBLIC_BASE=https://example.com
CURATE_OFFICIAL_USER_IDS=

# Optional OAuth provider
# Leave empty for local development unless you configure an OAuth app.
WATCHA_CLIENT_ID=
WATCHA_CLIENT_SECRET=
WATCHA_REDIRECT_URI=http://localhost:8000/api/v1/auth/callback
OAUTH_AUTHORIZE_URL=https://example.com/oauth/authorize
OAUTH_TOKEN_URL=https://example.com/oauth/api/token
OAUTH_USERINFO_URL=https://example.com/oauth/api/userinfo

# Optional observability and email
SENTRY_DSN=
NEXT_PUBLIC_SENTRY_DSN=
RESEND_API_KEY=
