# Browser-visible API base URL for local frontend development without nginx.
NEXT_PUBLIC_API_URL=http://localhost:8000

# Optional public Sentry DSN. This is not an auth token, but should still be
# separated by environment.
# NEXT_PUBLIC_SENTRY_DSN=https://public@example.ingest.sentry.io/project

# Server-side Next.js rewrite target. Do not use NEXT_PUBLIC_ for this value.
# Optional public CDN base for files in frontend/public.
# NEXT_PUBLIC_CDN_BASE=https://cdn.example.com/static

# BACKEND_URL=http://localhost:8000
